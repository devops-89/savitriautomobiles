
# RewriteEngine on
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP:X-Forwarded-SSL} !on
# RewriteCond %{HTTP_HOST} ^savitriautomobiles\.com$ [OR]
# RewriteCond %{HTTP_HOST} ^www\.savitriautomobiles\.com$
# RewriteRule ^/?$ "https\:\/\/savitriautomobiles\.com\/" [R=301,L]

RewriteEngine On
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]


# General rule to remove .html extension for all files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Specific rules for individual pages to remove .html extension
RewriteRule ^T&C$ T&C.html [L]
RewriteRule ^swaraj-735-fe-tractor$ swaraj-735-fe-tractor.html [L]

# Redirect .html URLs to extensionless versions (SEO-friendly)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]





